{
    "name": "acunsoft/datatable-laravel",
    "description": "Server side for Acun DataTable: an allowlisted, Turkish-aware Eloquent query applier and a JSON endpoint for the HTTP data source.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "eloquent", "datatable", "acun-datatable"],
    "require": {
        "php": "^8.2",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": { "Acunsoft\\DataTable\\Laravel\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Acunsoft\\DataTable\\Laravel\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": { "sort-packages": true },
    "minimum-stability": "stable",
    "prefer-stable": true
}
